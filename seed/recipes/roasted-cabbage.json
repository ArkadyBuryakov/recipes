            }
          },
          {
            "id": "roast",
            "text": {
              "ru": "Перемешать, выложить на противень и запекать {{timer:30m}}",
              "en": "Toss, spread on a baking tray and roast for {{timer:30m}}"
            }
          }
        ]
      },
      {
        "id": "dressing",
        "title": { "ru": "Заправка", "en": "Dressing" },
        "bowls": [{ "id": "jar", "label": { "ru": "Баночка", "en": "Jar" } }],
        "ingredients": [
          { "id": "olive-oil-dressing", "name": { "ru": "Оливковое масло", "en": "Olive oil" }, "qty": { "min": 1 }, "unit": "tbsp", "bowl": "jar" },
          { "id": "orange", "name": { "ru": "Апельсин", "en": "Orange" }, "qty": { "min": 0.5 }, "prep": { "ru": "выжать сок", "en": "juiced" }, "bowl": "jar" },
          { "id": "garlic", "name": { "ru": "Чеснок", "en": "Garlic" }, "qty": { "min": 2 }, "unit": "clove", "prep": { "ru": "раздавить", "en": "crushed" }, "bowl": "jar" },
          { "id": "soy", "name": { "ru": "Соевый соус", "en": "Soy sauce" }, "qty": { "min": 1 }, "unit": "tbsp", "bowl": "jar" },
          { "id": "dijon", "name": { "ru": "Дижонская горчица", "en": "Dijon mustard" }, "qty": { "min": 1 }, "unit": "tsp", "bowl": "jar" },
          { "id": "parmesan", "name": { "ru": "Пармезан", "en": "Parmesan" }, "qty": { "min": 70 }, "unit": "g", "bowl": "jar" }
        ],
        "steps": [
          {
            "id": "jar",
            "text": {
              "ru": "Пока запекается капуста, сложить в маленькую баночку {{ing:olive-oil-dressing}}, сок ({{ing:orange}}), {{ing:garlic}}, {{ing:soy}}, {{ing:dijon}} и {{ing:parmesan}}",

          { "id": "pepper", "name": { "ru": "Перец", "en": "Pepper" }, "scaling": "to-taste", "bowl": "spices" },
          { "id": "chili-flakes", "name": { "ru": "Хлопья чили", "en": "Chili flakes" }, "scaling": "to-taste", "bowl": "spices" },
          { "id": "oregano", "name": { "ru": "Орегано", "en": "Oregano" }, "scaling": "to-taste", "bowl": "spices" }
        ],
        "steps": [
          {
            "id": "cut",
            "text": { "ru": "Нарезать {{ing:cabbage}} крупными кусками", "en": "Cut the {{ing:cabbage}} into large chunks" }
          },
          {
            "id": "season",
            "text": {
              "ru": "Полить капусту {{ing:olive-oil}} и посыпать специями: {{ing:pepper}}, {{ing:chili-flakes}}, {{ing:oregano}} и т. д.",

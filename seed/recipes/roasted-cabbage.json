      "ru": "Крупные куски капусты, запечённые со специями, с заправкой из апельсина, горчицы и пармезана",
      "en": "Big chunks of cabbage roasted with spices, tossed with an orange, mustard and parmesan dressing"
    },
    "servings": { "amount": 2 },
    "times": { "cookMin": 30 },
    "tags": [
      { "ru": "гарнир", "en": "side" },
      { "ru": "овощи", "en": "vegetables" }
    ],
    "prepTasks": [
      { "id": "oven", "text": { "ru": "Разогреть духовку до 190 °C", "en": "Preheat the oven to 190 °C" } }
    ],
    "sections": [
      {
        "id": "cabbage",
        "title": { "ru": "Капуста", "en": "Cabbage" },
        "bowls": [{ "id": "spices", "label": { "ru": "Специи", "en": "Spices" } }],
        "ingredients": [

            }
          },
          {
            "id": "shake",
            "text": {
              "ru": "Закрыть банку и встряхнуть, чтобы всё перемешалось",
              "en": "Close the jar and shake until everything is combined"
            }
          },
          {
            "id": "toss",
            "text": {
              "ru": "Достать капусту, добавить заправку и перемешать",
              "en": "Take out the cabbage, add the dressing and toss"
            }
          }
        ]
      }
    ]
  }
}

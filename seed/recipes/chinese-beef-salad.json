          {
            "id": "heat-oil",
            "text": { "ru": "Поставить греться {{ing:oil}} на сковороде", "en": "Heat the {{ing:oil}} in a pan" }
          },
          {
            "id": "combine",
            "text": {
              "ru": "Пока греется масло, добавить к мясу перец, кинзу и остальное: {{ing:garlic}}, {{ing:chili-powder}}, {{ing:sesame}}, {{ing:soy}}, {{ing:vinegar}}, {{ing:oyster}}, {{ing:sugar}}",
              "en": "While the oil heats, add the chilies, cilantro and the rest to the meat: {{ing:garlic}}, {{ing:chili-powder}}, {{ing:sesame}}, {{ing:soy}}, {{ing:vinegar}}, {{ing:oyster}}, {{ing:sugar}}"
            }
          },
          {
            "id": "dress",
            "text": { "ru": "Облить горячим маслом и перемешать", "en": "Pour the hot oil over and toss" }

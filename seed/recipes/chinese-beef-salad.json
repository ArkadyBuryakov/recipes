          { "id": "oyster", "name": { "ru": "Устричный соус", "en": "Oyster sauce" }, "qty": { "min": 1 }, "unit": "tbsp", "bowl": "seasoning" },
          { "id": "sugar", "name": { "ru": "Сахар", "en": "Sugar" }, "qty": { "min": 0.5 }, "unit": "tbsp", "bowl": "seasoning" },

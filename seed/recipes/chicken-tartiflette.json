          { "id": "potatoes", "name": { "ru": "Картофель", "en": "Potatoes" }, "qty": { "min": 500 }, "unit": "g", "bowl": "potato-mix", "prep": { "ru": "крупно нарезать, примерно на 4 части", "en": "cut into large chunks, about 4 per potato" } },

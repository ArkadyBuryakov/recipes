          { "id": "garlic", "name": { "ru": "Чесночная паста", "en": "Garlic paste" }, "qty": { "min": 2 }, "unit": "tsp", "bowl": "potato-mix", "prep": { "ru": "турецкие чайные ложки", "en": "Turkish teaspoons" }, "alternatives": [{ "name": { "ru": "чесночный порошок", "en": "garlic powder" } }] },
          { "id": "olive-oil", "name": { "ru": "Оливковое масло", "en": "Olive oil" }, "qty": { "min": 2 }, "unit": "tbsp", "bowl": "potato-mix" },
          { "id": "salt", "name": { "ru": "Соль", "en": "Salt" }, "scaling": "to-taste" },
          { "id": "pepper", "name": { "ru": "Перец", "en": "Pepper" }, "scaling": "to-taste" }
        ],
        "steps": [
          { "id": "mix", "text": { "ru": "Смешать {{ing:bacon-diced}}, {{ing:potatoes}}, {{ing:onion}}, {{ing:garlic}}, {{ing:olive-oil}}, {{ing:salt}} и {{ing:pepper}}.", "en": "Toss together {{ing:bacon-diced}}, {{ing:potatoes}}, {{ing:onion}}, {{ing:garlic}}, {{ing:olive-oil}}, {{ing:salt}} and {{ing:pepper}}." } },
          { "id": "roast", "text": { "ru": "Переложить в форму и запекать в духовке {{timer:25m}}.", "en": "Transfer to a baking dish and roast for {{timer:25m}}." } }
        ]
      },
      {
        "id": "chicken",
        "title": { "ru": "Курица", "en": "Chicken" },
        "ingredients": [
          { "id": "chicken", "name": { "ru": "Куриная грудка", "en": "Chicken breast" }, "qty": { "min": 6 }, "prep": { "ru": "небольшие, по 125–150 г", "en": "small, about 125–150 g each" } },
          { "id": "bacon-wrap", "name": { "ru": "Бекон", "en": "Bacon" }, "qty": { "min": 6 }, "unit": "slice", "prep": { "ru": "широкий", "en": "wide rashers" } },
          { "id": "mushrooms", "name": { "ru": "Шампиньоны", "en": "Button mushrooms" }, "qty": { "min": 200 }, "unit": "g", "prep": { "ru": "нарезать", "en": "sliced" } },
          { "id": "parsley", "name": { "ru": "Петрушка", "en": "Parsley" }, "qty": { "min": 2 }, "unit": "tbsp", "prep": { "ru": "нарезать", "en": "chopped" } },
          { "id": "thyme", "name": { "ru": "Тимьян", "en": "Thyme" }, "qty": { "min": 1 }, "unit": "tbsp" }

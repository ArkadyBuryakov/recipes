          { "id": "chop", "text": { "ru": "Нарезать {{ing:mushrooms}} и {{ing:parsley}}.", "en": "Slice the {{ing:mushrooms}} and chop the {{ing:parsley}}." } }
        ]
      },
      {
        "id": "bake",
        "title": { "ru": "Запекание", "en": "Baking" },
        "ingredients": [
          { "id": "wine", "name": { "ru": "Белое вино", "en": "White wine" }, "qty": { "min": 200 }, "unit": "ml" },
          { "id": "cream", "name": { "ru": "Сливки 30%", "en": "Cream (30% fat)" }, "qty": { "min": 150 }, "unit": "ml" },
          { "id": "camembert", "name": { "ru": "Камамбер", "en": "Camembert" }, "qty": { "min": 115 }, "unit": "g", "alternatives": [{ "name": { "ru": "бри", "en": "brie" } }] },
          { "id": "mustard", "name": { "ru": "Зернистая горчица", "en": "Wholegrain mustard" }, "qty": { "min": 1 }, "unit": "tbsp" },
          { "id": "lemon", "name": { "ru": "Лимонный сок", "en": "Lemon juice" }, "qty": { "min": 1 }, "unit": "tbsp", "optional": true }
        ],
        "steps": [
          { "id": "layer", "text": { "ru": "Достать картофель, выложить сверху {{ing:mushrooms}}, порвать на кусочки {{ing:camembert}}, влить {{ing:wine}} и {{ing:cream}}, перемешать.", "en": "Take the potatoes out, top with the {{ing:mushrooms}}, tear over the {{ing:camembert}}, pour in the {{ing:wine}} and {{ing:cream}} and stir." } },
          { "id": "bake-chicken", "text": { "ru": "Сверху выложить {{ing:chicken}} и запекать ещё около {{timer:20m}}.", "en": "Lay the {{ing:chicken}} on top and bake for about {{timer:20m}} more." } },
          { "id": "finish", "text": { "ru": "Достать из духовки. Курицу по желанию нарезать на несколько частей. В картофель добавить {{ing:lemon}}, {{ing:mustard}} и {{ing:parsley}}, перемешать.", "en": "Take out of the oven. Cut the chicken into pieces if you like. Stir {{ing:lemon}}, {{ing:mustard}} and {{ing:parsley}} into the potatoes." } },
          { "id": "thicken", "text": { "ru": "Если соус получился жидким, подержать картофель с овощами (без курицы) на плите до загустения соуса.", "en": "If the sauce is too runny, simmer the potatoes and vegetables (without the chicken) on the stove until the sauce thickens." } }
        ]
      }
    ]
  }

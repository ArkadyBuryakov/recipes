# Production environment (Coolify). Local development needs none of these (compose.yaml sets them).
PUBLIC_URL=https://recipes.buryakov.pro
DATABASE_URL=postgres://user:password@host:5432/recipes
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# First admin, created on first start when there are no users yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Arkady
# Hetzner Object Storage (Nuremberg), private bucket
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Web Push for kitchen timers: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:arkady@buryakov.pro

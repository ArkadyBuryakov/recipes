{
  "name": "recipes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun server.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests/unit",
    "test:integration": "scripts/with-test-db.sh bun test tests/integration",
    "test:e2e": "scripts/with-test-db.sh playwright test",
    "check": "biome check . && bun run typecheck && bun run test",
    "check:all": "bun run check && bun run test:integration && bun run test:e2e",
    "db:generate": "drizzle-kit generate",
    "cli": "bun server.ts cli",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.15",
    "@better-auth/cimd": "^1.7.15",
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@better-auth/mcp": "^1.7.15",
    "@better-auth/oauth-provider": "^1.7.15",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "@react-router/node": "^8.5.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "isbot": "^5.2.2",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
